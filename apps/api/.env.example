# Copy this file to one of:
#   apps/api/.env.local   → loaded when running `dotnet run` locally (takes precedence)
#   apps/api/.env         → loaded in production (inside Docker)
#
# Both files are gitignored. The docker-compose files read the POSTGRES_* vars
# below via variable interpolation, so keep them consistent with ConnectionStrings__Default.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080

# --- database ---
POSTGRES_USER=jovie
POSTGRES_PASSWORD=change_me
POSTGRES_DB=jovie_joy
# Optional overrides for docker-compose.prod.yml. Production defaults to
# shared-postgres:5432 when these are omitted.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ConnectionStrings__Default=Host=localhost;Port=5432;Database=jovie_joy;Username=jovie;Password=change_me

# --- JWT ---
# openssl rand -base64 48
Jwt__Secret=change_me_at_least_32_bytes_of_random
Jwt__Issuer=jovie-joy-api
Jwt__Audience=jovie-joy-web
Jwt__ExpiryMinutes=60

# --- Google OAuth ---
Google__ClientId=your-client-id.apps.googleusercontent.com
Google__ClientSecret=your-client-secret
Google__RedirectUri=http://localhost:8080/auth/google/callback

# --- Frontend URL (CORS + post-auth redirect) ---
WebAppUrl=http://localhost:3000

# --- Storefront cache revalidation ---
# API and Next.js must share this secret. Generate it with:
# openssl rand -hex 32
# In production docker-compose passes the same value to both containers.
CACHE_REVALIDATION_SECRET=
# Local dotnet + Next.js development only. Production compose overrides these.
StorefrontCache__Endpoint=http://localhost:3000/api/internal/revalidate
StorefrontCache__Secret=${CACHE_REVALIDATION_SECRET}
StorefrontCache__TimeoutSeconds=2

# --- Stripe ---
Stripe__SecretKey=sk_test_REPLACE_ME
Stripe__WebhookSecret=whsec_REPLACE_ME
Stripe__SuccessUrl=http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}
Stripe__CancelUrl=http://localhost:3000/checkout

# --- Admin bootstrap (required only while the database has no admin) ---
# Generate a unique secret, for example: openssl rand -base64 32
# The API rejects blank, common/default, placeholder, or <16-character passwords.
Admin__Email=admin@example.com
Admin__Password=

# --- Admin login rate limiting ---
# Defaults to 5 attempts per client IP per 60-second window.
RateLimiting__AdminLogin__PermitLimit=5
RateLimiting__AdminLogin__WindowSeconds=60
# Anonymous checkout and freebie email endpoints have separate per-client-IP
# limits so one workflow cannot consume the other's allowance.
RateLimiting__Checkout__PermitLimit=10
RateLimiting__Checkout__WindowSeconds=60
RateLimiting__FreebieRequest__PermitLimit=5
RateLimiting__FreebieRequest__WindowSeconds=3600
# Trust only the reverse proxy address that directly connects to the API. Add
# more entries with __1, __2, etc.; leave empty for direct/local deployments.
# ForwardedHeaders__KnownProxies__0=172.18.0.1

# --- Resend (transactional email) ---
# Leave ApiKey blank in dev — the sender logs to console and returns success.
Resend__ApiKey=
Resend__FromAddress=hello@jovie-joy.local
Resend__FromName=Jovie Joy

# --- Freebies ---
Freebies__DownloadTtlDays=7
Freebies__MaxFileSizeMb=15
# Public HTTPS API origin used in emailed freebie and paid-product links.
PUBLIC_API_URL=https://api.example.com
Freebies__BaseUrl=${PUBLIC_API_URL}

# --- Paid digital product downloads ---
ProductDownloads__DownloadTtlDays=30

# --- Abandoned upload cleanup ---
# Files are deleted only when no CMS row references them and they are older than
# this grace period. TimeSpan format is days.hours:minutes:seconds.
OrphanUploadCleanup__MinimumAge=1.00:00:00
OrphanUploadCleanup__StartupDelay=00:05:00
OrphanUploadCleanup__Interval=1.00:00:00
