{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Resend": {
    "ApiKey": "",
    "FromAddress": "hello@jovie-joy.local",
    "FromName": "Jovie Joy"
  },
  "Freebies": {
    "DownloadTtlDays": 7,
    "MaxFileSizeMb": 15,
    "BaseUrl": "http://localhost:8080"
  },
  "ProductDownloads": {
    "DownloadTtlDays": 30
  },
  "OrphanUploadCleanup": {
    "MinimumAge": "1.00:00:00",
    "StartupDelay": "00:05:00",
    "Interval": "1.00:00:00"
  },
  "StorefrontCache": {
    "Endpoint": "",
    "Secret": "",
    "TimeoutSeconds": 2
  },
  "RateLimiting": {
    "AdminLogin": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Checkout": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "FreebieRequest": {
      "PermitLimit": 5,
      "WindowSeconds": 3600
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
